{
  "expo": {
    "name": "Hifz",
    "slug": "hifz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hifz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EC"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hifz.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hifz needs the microphone so you can recite verses during memorization sessions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6EC"
      },
      "package": "com.hifz.app",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Hifz to access the microphone for memorization sessions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
