{
  "name": "quran-memorization-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:enhanced": "vitest --config=src/tests/enhanced/vitest.enhanced.config.ts",
    "test:enhanced:run": "vitest run --config=src/tests/enhanced/vitest.enhanced.config.ts",
    "test:enhanced:coverage": "vitest run --config=src/tests/enhanced/vitest.enhanced.config.ts --coverage",
    "test:enhanced:watch": "vitest --config=src/tests/enhanced/vitest.enhanced.config.ts --watch",
    "test:enhanced:ui": "vitest --config=src/tests/enhanced/vitest.enhanced.config.ts --ui",
    "test:stress": "vitest run src/tests/enhanced/islamic-content-stress.test.ts",
    "test:memory": "vitest run src/tests/enhanced/memory-leak-detection.test.ts",
    "test:network": "vitest run src/tests/enhanced/network-failure-recovery.test.ts",
    "test:accessibility": "vitest run src/tests/enhanced/accessibility-compliance.test.ts",
    "test:mobile": "vitest run src/tests/enhanced/mobile-optimization-performance.test.ts",
    "test:compatibility": "vitest run src/tests/enhanced/cross-browser-compatibility.test.ts",
    "test:ramadan": "vitest run src/tests/enhanced/ramadan-prayer-time-awareness.test.ts",
    "test:visual": "vitest run src/tests/enhanced/visual-regression-testing.test.ts",
    "test:security": "vitest --config=vitest.security.config.ts",
    "test:security:run": "vitest run --config=vitest.security.config.ts",
    "test:security:coverage": "vitest run --config=vitest.security.config.ts --coverage",
    "test:load": "vitest run src/tests/enhanced/load-testing.test.ts",
    "test:all": "npm run test && npm run test:enhanced:run && npm run test:security:run",
    "test:report": "npm run test:enhanced:coverage && npm run test:enhanced:run && npm run test:security:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:performance": "playwright test tests/e2e/specs/performance.spec.ts",
    "test:e2e:pwa": "playwright test tests/e2e/specs/pwa-offline.spec.ts",
    "test:e2e:islamic": "playwright test tests/e2e/specs/islamic-features.spec.ts",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@heroicons/react": "^2.1.1",
    "@playwright/test": "^1.56.1",
    "@sentry/react": "^10.22.0",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.4.17",
    "axios": "^1.6.7",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^11.0.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "tailwindcss": "^3.4.0",
    "wavesurfer.js": "^7.11.0",
    "workbox-window": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@mswjs/data": "^0.16.2",
    "@sentry/vite-plugin": "^4.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^4.0.5",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.0.1",
    "msw": "^2.11.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.2.2",
    "vite": "^6.4.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
