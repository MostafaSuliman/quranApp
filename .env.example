# QuranApp Environment Variables
# ==========================================
# SECURITY WARNING: Never commit actual secrets to version control!
# Copy this file to .env and update with your actual values.
# ==========================================

# ==========================================
# Security Configuration
# ==========================================

# JWT Secret - CRITICAL SECURITY SETTING
# IMPORTANT: Generate a secure random secret for production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# OR: openssl rand -hex 64
JWT_SECRET=your-secure-jwt-secret-here-change-this-in-production-MUST-BE-CHANGED

# Encryption Keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_ENCRYPTION_KEY=your-encryption-key-here-32-bytes-minimum
VITE_ENCRYPTION_IV=your-initialization-vector-here

# Session Configuration
VITE_SESSION_TIMEOUT=3600000
VITE_SESSION_REFRESH_ENABLED=true
VITE_SESSION_SECURE_COOKIE=true

# CSRF Protection
VITE_CSRF_TOKEN_LENGTH=32
VITE_CSRF_TOKEN_HEADER=X-CSRF-Token

# ==========================================
# API Configuration
# ==========================================

VITE_API_BASE_URL=https://api.quranapp.com
VITE_QURAN_API_URL=https://api.quran.com
VITE_ISLAMIC_NETWORK_API_URL=https://cdn.islamic.network
VITE_EVERYAYAH_API_URL=https://everyayah.com

# API Security
VITE_API_KEY=your-api-key-here-if-needed
VITE_API_RATE_LIMIT=100
VITE_API_TIMEOUT=30000

# ==========================================
# Content Security Policy (CSP)
# ==========================================

VITE_ENABLE_CSP=true
VITE_CSP_REPORT_URI=/api/security/csp-violation
VITE_CSP_REPORT_ONLY=false

# ==========================================
# Security Features
# ==========================================

# Two-Factor Authentication
VITE_ENABLE_2FA=true
VITE_2FA_ISSUER=QuranApp
VITE_2FA_BACKUP_CODES_COUNT=10

# Rate Limiting
VITE_ENABLE_RATE_LIMITING=true
VITE_RATE_LIMIT_WINDOW=900000
VITE_RATE_LIMIT_MAX_REQUESTS=100

# XSS Protection
VITE_ENABLE_XSS_PROTECTION=true
VITE_XSS_AUTO_SANITIZE=true

# CORS Configuration
VITE_CORS_ENABLED=true
VITE_CORS_ORIGINS=https://quranapp.com,https://www.quranapp.com
VITE_CORS_CREDENTIALS=true

# ==========================================
# Error Monitoring (Sentry)
# ==========================================

VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Sentry Build Configuration (for CI/CD)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=quranapp
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ==========================================
# Feature Flags
# ==========================================

VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_TELEMETRY=false

# ==========================================
# Development & Debugging
# ==========================================

VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info
VITE_ENABLE_SOURCE_MAPS=false

# ==========================================
# Performance Monitoring
# ==========================================

VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_SESSION_REPLAY=false
VITE_PERFORMANCE_SAMPLE_RATE=0.1

# ==========================================
# App Configuration
# ==========================================

VITE_APP_NAME=QuranApp
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production
VITE_APP_URL=https://quranapp.com

# ==========================================
# Privacy & Compliance
# ==========================================

VITE_ENABLE_GDPR_MODE=true
VITE_ENABLE_COOKIE_CONSENT=true
VITE_DATA_RETENTION_DAYS=90
VITE_ENABLE_DO_NOT_TRACK=true

# ==========================================
# Security Headers
# ==========================================

VITE_ENABLE_HSTS=true
VITE_HSTS_MAX_AGE=31536000
VITE_ENABLE_X_FRAME_OPTIONS=true
VITE_X_FRAME_OPTIONS=DENY
VITE_ENABLE_X_CONTENT_TYPE_OPTIONS=true
VITE_ENABLE_REFERRER_POLICY=true
VITE_REFERRER_POLICY=strict-origin-when-cross-origin

# ==========================================
# Production Security Checklist
# ==========================================
# [ ] Change JWT_SECRET to a secure random value
# [ ] Generate unique VITE_ENCRYPTION_KEY and VITE_ENCRYPTION_IV
# [ ] Configure Sentry DSN and authentication
# [ ] Set appropriate CORS origins
# [ ] Enable HTTPS only (VITE_SESSION_SECURE_COOKIE=true)
# [ ] Review and adjust rate limiting settings
# [ ] Configure CSP headers appropriately
# [ ] Test all authentication flows
# [ ] Verify XSS protection is working
# [ ] Run security audit: npm run test:security
# [ ] Review and enable appropriate feature flags
