# Production Environment Variables
# DO NOT commit this file with real values!

# API Configuration
VITE_API_BASE_URL=https://api.quran.com/api/v4

# Feature Flags
VITE_ENABLE_CSP=true
VITE_ENABLE_SENTRY=false
VITE_ENABLE_ANALYTICS=false

# Build Configuration
VITE_BUILD_ENV=production
VITE_APP_VERSION=1.0.0

# Security (REPLACE WITH ACTUAL VALUES BEFORE DEPLOYING)
# Generate: openssl rand -hex 64
VITE_JWT_SECRET=your-production-jwt-secret-here

# Sentry Error Monitoring (get DSN from https://sentry.io after creating account)
VITE_SENTRY_DSN=
# Example: VITE_SENTRY_DSN=https://1234567890abcdef@o123456.ingest.sentry.io/123456

# Sentry Build Configuration (for source map uploads)
SENTRY_ORG=
SENTRY_PROJECT=quranapp
SENTRY_AUTH_TOKEN=

# Performance
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_VERSION=v1
